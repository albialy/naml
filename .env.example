# Model provider keys
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Storage: sqlite or postgres
STORAGE_BACKEND=sqlite

# Persistent data directory
# NAML_DATA_DIR=C:/NAML-data
# DATABASE_PATH=C:/NAML-data/naml.sqlite3

# PostgreSQL connection, when STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://naml:YOUR_PASSWORD@127.0.0.1:5432/naml

# Recovery for deployments running a single API process
NAML_RECOVER_INTERRUPTED=true

# Only for importing old Supabase analyses
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
